# Copy this file to backend/.env
# SQLite: a local file, no database server needed. Prisma creates this file
# automatically the first time you run `npm run db:migrate`.
DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional: switch to Postgres later by changing schema.prisma's datasource
# provider to "postgresql" and pointing this at a real connection string, e.g.
# DATABASE_URL="postgresql://taskdash:taskdash@localhost:5432/task_dashboard?schema=public"
